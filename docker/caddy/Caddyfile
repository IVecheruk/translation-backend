{
	email {$ACME_EMAIL}
	admin off

	servers {
		max_header_size 32KB
		timeouts {
			read_body 30s
			read_header 10s
			write 65s
			idle 30s
		}
	}
}

{$PUBLIC_DOMAIN} {
	log {
		output stdout
		format json
	}

	@operational path /actuator /actuator/* /livez /readyz
	respond @operational 404

	request_body {
		max_size 21MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy backend:8080 {
		health_uri /readyz
		health_interval 10s
		health_timeout 3s
		health_status 200
		health_fails 3
		health_passes 2
		fail_duration 30s
		max_fails 3

		transport http {
			dial_timeout 3s
			response_header_timeout 60s
			read_timeout 65s
			write_timeout 30s
		}
	}
}
